# Copy to .env and fill in the keys you have. Every script skips providers whose key is missing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the default model per provider with one you have access to.
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2
